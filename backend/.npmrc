; Default npm settings for the backend.
; - audit/fund off so deploys are not slowed by network calls to the registry
; - longer fetch timeout for slow VPS networks (helps avoid partial-download
;   corruption like the validator/isFloat.js MODULE_NOT_FOUND we hit before).
; - engine-strict ensures Node version mismatches fail loudly instead of
;   producing a half-built tree.
audit=false
fund=false
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=20000
engine-strict=true
