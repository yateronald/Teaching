# PostgreSQL Configuration for French Teaching Platform
# Copy this file to .env to use PostgreSQL instead of SQLite

# Database Type
DATABASE_TYPE=postgresql

# Local PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Teaching
DB_USER=postgres
DB_PASSWORD=10108924

# Alternative: Use DATABASE_URL for cloud PostgreSQL (like Neon)
# Uncomment and set this for Neon PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Application Settings
NODE_ENV=development
PORT=3000

# Email Configuration (keep existing settings)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@domain.com

# JWT Secret (keep existing or generate new)
JWT_SECRET=your-jwt-secret-key-here

# Session Configuration
SESSION_SECRET=your-session-secret-key-here

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Quiz Configuration
QUIZ_AUTO_SUBMIT_BUFFER_MINUTES=5
QUIZ_REMINDER_HOURS_BEFORE=24

# Security Configuration
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
PASSWORD_EXPIRY_DAYS=90